# Copy to .env at repository root for Compose. Do not commit real secrets.
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://btl:btl@db:5432/btl
CHECKPOINT_URL=postgresql://btl:btl@db:5432/btl
POSTGRES_PASSWORD=btl
PUBLIC_ORIGIN=http://localhost:8080
SESSION_SECRET=development-only-change-before-production
DEV_LOGIN_ENABLED=true
AGENT_MODE=deepseek
DEEPSEEK_API_KEY="" # Configure only in the untracked local .env file.

# OpenAI-compatible gateway: set AGENT_MODE=openai to use Responses API.
OPENAI_BASE_URL=https://api.openai-next.com/v1
OPENAI_API_KEY=""
OPENAI_MODEL=gpt-6-astra
OPENAI_MAX_RETRIES=1
OPENAI_MAX_OUTPUT_TOKENS=1600
# Set actual gateway prices before enabling a dollar-denominated cost cap.
# OPENAI_INPUT_USD_PER_MILLION=
# OPENAI_OUTPUT_USD_PER_MILLION=
DAILY_TURN_LIMIT=100
MAX_CONCURRENT_TURNS=30
TURN_TIMEOUT_SECONDS=60
MAX_MODEL_CALLS=4
MAX_TOOL_CALLS=6
# Conservative peak estimates; check current pricing before enabling real calls.
DEEPSEEK_INPUT_USD_PER_MILLION=0.30
DEEPSEEK_OUTPUT_USD_PER_MILLION=1.20
ZHIHU_CLIENT_ID=
# standard keeps compatibility with standard OAuth providers; hackathon uses app_id/app_key.
ZHIHU_PROTOCOL=standard
ZHIHU_CLIENT_SECRET=
ZHIHU_AUTHORIZE_URL=
ZHIHU_TOKEN_URL=
ZHIHU_USERINFO_URL=
ZHIHU_SCOPE=
# For hackathon native /user, set subject=uid and name=fullname (verified live).
ZHIHU_SUBJECT_FIELD=id
ZHIHU_NAME_FIELD=name

# Zhihu public data API credential (separate from OAuth and DeepSeek)
ZHIHU_ACCESS_SECRET=

# Product v2 switches. Disabling creation does not block existing v2 saves.
STORY_V2_ENABLED=true
GUEST_ENABLED=true
AUTOMATIC_INTENTS_ENABLED=true
DISCUSSIONS_ENABLED=true
GUEST_AI_LIMIT=8
GUEST_DAYS=7
ACTIVE_SAVE_LIMIT=20
MUTATION_LIMIT_PER_MINUTE=60
AI_INPUT_BYTE_LIMIT=24000
# Configure only the private Docker proxy network in production; never trust arbitrary headers.
TRUSTED_PROXY_NETWORKS=[]

# Local development only: keep guest identity/saves while allowing acts 2 and 3.
# Production refuses to start if this is enabled; guest AI quotas still apply.
GUEST_FULL_STORY_ENABLED=false

# GPT6 requires low or above. A supported GPT5.6 model may use none for faster dialogue.
OPENAI_REASONING_EFFORT=low
