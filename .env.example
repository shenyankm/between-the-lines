# Copy to .env at repository root for Compose. Do not commit real secrets.
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://btl:btl@db:5432/btl
CHECKPOINT_URL=postgresql://btl:btl@db:5432/btl
POSTGRES_PASSWORD=btl
PUBLIC_ORIGIN=http://localhost:8080
SESSION_SECRET=development-only-change-before-production
DEV_LOGIN_ENABLED=true
AGENT_MODE=deepseek
DEEPSEEK_API_KEY="" # Configure only in the untracked local .env file.
MAX_CONCURRENT_TURNS=30
TURN_TIMEOUT_SECONDS=60
ZHIHU_CLIENT_ID=
# standard keeps compatibility with standard OAuth providers; hackathon uses app_id/app_key.
ZHIHU_PROTOCOL=standard
ZHIHU_CLIENT_SECRET=
ZHIHU_AUTHORIZE_URL=
ZHIHU_TOKEN_URL=
ZHIHU_USERINFO_URL=
ZHIHU_SCOPE=
# For hackathon native /user, set subject=uid and name=fullname (verified live).
ZHIHU_SUBJECT_FIELD=id
ZHIHU_NAME_FIELD=name

# Zhihu public data API credential (separate from OAuth and DeepSeek)
ZHIHU_ACCESS_SECRET=

# Product v2 switches. Disabling creation does not block existing v2 saves.
# Local/test trials only; production always disables guests. Set false on the server.
GUEST_ENABLED=true
AUTOMATIC_INTENTS_ENABLED=true
DISCUSSIONS_ENABLED=true
GUEST_DAYS=7
ACTIVE_SAVE_LIMIT=20
# Configure only the private Docker proxy network in production; never trust arbitrary headers.
TRUSTED_PROXY_NETWORKS=[]
