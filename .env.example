# Copy to .env at repository root for Compose. Do not commit real secrets.
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://btl:btl@db:5432/btl
CHECKPOINT_URL=postgresql://btl:btl@db:5432/btl
POSTGRES_PASSWORD=btl
PUBLIC_ORIGIN=http://localhost:8080
SESSION_SECRET=development-only-change-before-production
DEV_LOGIN_ENABLED=true
AGENT_MODE=deepseek
DEEPSEEK_API_KEY="" # Configure only in the untracked local .env file.
DAILY_TURN_LIMIT=100
MAX_CONCURRENT_TURNS=30
TURN_TIMEOUT_SECONDS=60
MAX_MODEL_CALLS=4
MAX_TOOL_CALLS=6
# Conservative peak estimates; check current pricing before enabling real calls.
DEEPSEEK_INPUT_USD_PER_MILLION=0.30
DEEPSEEK_OUTPUT_USD_PER_MILLION=1.20
ZHIHU_CLIENT_ID=
ZHIHU_CLIENT_SECRET=
ZHIHU_AUTHORIZE_URL=
ZHIHU_TOKEN_URL=
ZHIHU_USERINFO_URL=
ZHIHU_SCOPE=
ZHIHU_SUBJECT_FIELD=id
ZHIHU_NAME_FIELD=name

# Zhihu public data API credential (separate from OAuth and DeepSeek)
ZHIHU_ACCESS_SECRET=

# Optional OpenAI-compatible provider. Set AGENT_MODE=openai to enable.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
# Optional gateway prices; leave absent until verified with your provider.
# OPENAI_INPUT_USD_PER_MILLION=...
# OPENAI_OUTPUT_USD_PER_MILLION=...
