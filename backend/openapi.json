  "components": {
    "schemas": {
      "Act": {
        "properties": {
          "title": {
            "type": "string",
            "title": "Title"
          },
          "chapter_title": {
            "type": "string",
            "title": "Chapter Title"
          },
          "location": {
            "type": "string",
            "title": "Location"
          },
          "time": {
            "type": "string",
            "title": "Time"
          },
          "intro": {
            "type": "string",
            "title": "Intro"
          },
          "background": {
            "type": "string",
            "title": "Background"
          },
          "choices": {
            "items": {
              "$ref": "#/components/schemas/Choice"
            },
            "type": "array",
            "title": "Choices"
          },
          "interlude": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Interlude"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "title",
          "chapter_title",
          "location",
          "time",
          "intro",
          "background",
          "choices"
        ],
        "title": "Act"
      },
      "ActiveTurn": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "request_id": {
            "type": "string",
            "title": "Request Id"
          }
        },
        "type": "object",
        "required": [
          "id",
          "request_id"
        ],
        "title": "ActiveTurn"
      },
      "Choice": {
        "properties": {
          "label": {
            "type": "string",
            "title": "Label"
          },
          "action": {
            "type": "string",
