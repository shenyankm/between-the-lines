    "/api/saves/{save_id}/turns": {
      "post": {
        "summary": "Submit",
        "operationId": "submit_api_saves__save_id__turns_post",
        "parameters": [
          {
            "name": "save_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
